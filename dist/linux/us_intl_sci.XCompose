# US-International Scientific 1.7.0 -- dead key sequences
#
# Generated from layout/us-intl-scientific.toml by tools/generate.py.
# Do not edit this file; edit the layout source and regenerate.
#
# Install as ~/.XCompose, or point XCOMPOSEFILE at it, then restart the
# applications that should pick it up.

# Keep everything the locale already defines.
include "%L"

# Grave accents -- AltGr dead key, root U+0300 COMBINING GRAVE ACCENT
<dead_grave> <a>                                : "à"	U00E0	# LATIN SMALL LETTER A WITH GRAVE
<dead_grave> <w>                                : "ẁ"	U1E81	# LATIN SMALL LETTER W WITH GRAVE
<dead_grave> <e>                                : "è"	U00E8	# LATIN SMALL LETTER E WITH GRAVE
