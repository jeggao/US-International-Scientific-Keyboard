    <action id="start0301">  <!-- Acute accent + typographical single quotes -->
      <when state="none" next="dead0301"/>
    </action>
    <action id="start0308">  <!-- Diaeresis diacritic + dot diacritics -->
      <when state="none" next="dead0308"/>
