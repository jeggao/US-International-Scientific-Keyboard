    <action id="start00B5">  <!-- Script font letters -->
      <when state="none" next="dead00B5"/>
    </action>
    <action id="start0327">  <!-- Cedilla and ogonek diacritics -->
      <when state="none" next="dead0327"/>
    </action>
    <action id="start003C">  <!-- Less-than operator variants + left ceiling/floor -->
      <when state="none" next="dead003C"/>
    </action>
    <action id="start0323">  <!-- Underdot diacritic + dot-related symbols -->
      <when state="none" next="dead0323"/>
