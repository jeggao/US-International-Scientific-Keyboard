  <actions>
    <action id="start0300">  <!-- Grave accents -->
      <when state="none" next="dead0300"/>
    </action>
    <action id="start0303">  <!-- Tilde diacritic + math equality symbols -->
      <when state="none" next="dead0303"/>
    </action>
    <action id="start030C">  <!-- Caron diacritic -->
      <when state="none" next="dead030C"/>
    </action>
    <action id="start0302">  <!-- Circumflex accents -->
      <when state="none" next="dead0302"/>
    </action>
    <action id="start00A6">  <!-- Ligatures + North European letters -->
      <when state="none" next="dead00A6"/>
    </action>
    <action id="start0307">  <!-- Dot above diacritic -->
      <when state="none" next="dead0307"/>
    </action>
    <action id="start030A">  <!-- Ring above diacritic + circle symbols -->
      <when state="none" next="dead030A"/>
    </action>
