    </action>
    <action id="start03F6">  <!-- Set membership operators + nonexistential quantifier -->
      <when state="none" next="dead03F6"/>
    </action>
    <action id="start00B1">  <!-- Relational operators + tack-like symbols -->
      <when state="none" next="dead00B1"/>
    </action>
    <action id="start0283">  <!-- Integral operators -->
      <when state="none" next="dead0283"/>
    </action>
    <action id="start03D5">  <!-- Circle-related operators + QED -->
