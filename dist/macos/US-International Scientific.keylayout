  <terminators>
    <when state="dead0300" output="&#x0300;"/>  <!-- U+0300 COMBINING GRAVE ACCENT -->
    <when state="dead0303" output="&#x0303;"/>  <!-- U+0303 COMBINING TILDE -->
    <when state="dead030C" output="&#x030C;"/>  <!-- U+030C COMBINING CARON -->
    <when state="dead0302" output="&#x0302;"/>  <!-- U+0302 COMBINING CIRCUMFLEX ACCENT -->
    <when state="dead00A6" output="¦"/>  <!-- U+00A6 BROKEN BAR -->
    <when state="dead0307" output="&#x0307;"/>  <!-- U+0307 COMBINING DOT ABOVE -->
    <when state="dead030A" output="&#x030A;"/>  <!-- U+030A COMBINING RING ABOVE -->
    <when state="dead00AA" output="ª"/>  <!-- U+00AA FEMININE ORDINAL INDICATOR -->
    <when state="dead00BA" output="º"/>  <!-- U+00BA MASCULINE ORDINAL INDICATOR -->
    <when state="dead01A9" output="Ʃ"/>  <!-- U+01A9 LATIN CAPITAL LETTER ESH -->
    <when state="dead03F6" output="϶"/>  <!-- U+03F6 GREEK REVERSED LUNATE EPSILON SYMBOL -->
    <when state="dead00B1" output="±"/>  <!-- U+00B1 PLUS-MINUS SIGN -->
    <when state="dead0283" output="ʃ"/>  <!-- U+0283 LATIN SMALL LETTER ESH -->
    <when state="dead03D5" output="ϕ"/>  <!-- U+03D5 GREEK PHI SYMBOL -->
    <when state="dead0250" output="ɐ"/>  <!-- U+0250 LATIN SMALL LETTER TURNED A -->
    <when state="dead03B3" output="γ"/>  <!-- U+03B3 GREEK SMALL LETTER GAMMA -->
    <when state="dead0126" output="Ħ"/>  <!-- U+0126 LATIN CAPITAL LETTER H WITH STROKE -->
    <when state="dead0301" output="&#x0301;"/>  <!-- U+0301 COMBINING ACUTE ACCENT -->
    <when state="dead0308" output="&#x0308;"/>  <!-- U+0308 COMBINING DIAERESIS -->
    <when state="dead01B5" output="Ƶ"/>  <!-- U+01B5 LATIN CAPITAL LETTER Z WITH STROKE -->
    <when state="dead0304" output="&#x0304;"/>  <!-- U+0304 COMBINING MACRON -->
    <when state="dead0306" output="&#x0306;"/>  <!-- U+0306 COMBINING BREVE -->
    <when state="dead00B5" output="µ"/>  <!-- U+00B5 MICRO SIGN -->
    <when state="dead0327" output="&#x0327;"/>  <!-- U+0327 COMBINING CEDILLA -->
    <when state="dead003C" output="&lt;"/>  <!-- U+003C LESS-THAN SIGN -->
    <when state="dead0323" output="&#x0323;"/>  <!-- U+0323 COMBINING DOT BELOW -->
    <when state="dead003E" output="&gt;"/>  <!-- U+003E GREATER-THAN SIGN -->
    <when state="dead0338" output="&#x0338;"/>  <!-- U+0338 COMBINING LONG SOLIDUS OVERLAY -->
  </terminators>

</keyboard>
